@model QuestLog.Models.Data.VideoGame

@{
    ViewData["Title"] = Model.Title;
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@Model.Title</h3>
        @if (Model.IsComplete)
        {
            <span class="badge bg-success fs-6">Completed</span>
        }
        else
        {
            <span class="badge bg-warning text-dark fs-6">In Progress</span>
        }
    </div>
    <div class="card-body">
        <p><strong>Studio:</strong> @Model.Studio?.Name (@Model.Studio?.Country)</p>
        <p><strong>Platform:</strong> @Model.Platform</p>
        <p><strong>Release Year:</strong> @Model.ReleaseYear</p>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-action="Index" class="btn btn-secondary">Back to Games</a>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Play Milestones</h4>
    <a asp-controller="Milestones" asp-action="Create" asp-route-gameId="@Model.Id" class="btn btn-success btn-sm">+ Log Milestone</a>
</div>

@if (!Model.Milestones.Any())
{
    <div class="alert alert-secondary">No milestones logged for this game yet.</div>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Milestone</th>
                <th>Achieved Date</th>
                <th>Hours Logged</th>
                <th class="text-center" style="width: 60px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Milestones)
            {
                <tr>
                    <td>@m.MilestoneTitle</td>
                    <td>@m.AchievedDate.ToString("yyyy-MM-dd")</td>
                    <td>@m.HoursLogged hrs</td>
                    <td class="text-center">
                        <form asp-controller="Milestones" asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link text-danger p-0" title="Delete Milestone">
                                <svg xmlns="http://w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}